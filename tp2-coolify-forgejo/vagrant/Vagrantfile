# VM dediee a Coolify + Forgejo (TP2)
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.hostname = "coolify-vm"

  # Reseau prive, IP fixe (la .10 est deja prise par web1)
  config.vm.network "private_network", ip: "192.168.56.70"

  # Port SSH fixe pour eviter les conflits avec les autres VM
  config.vm.network "forwarded_port", guest: 22, host: 2205, id: "ssh"

  # Ressources recommandees par le TP : 2 vCPU, 4 Go de RAM
  config.vm.provider "virtualbox" do |vb|
    vb.name   = "coolify-vm"
    vb.memory = 4096
    vb.cpus   = 2
  end
end
